data: {"candidates": [{"content": {"parts": [{"functionCall": {"name": "edit","args": {"path": "src/money.mjs","edits": [{"oldText": "export function parseMoney(value) {\n  const text = String(value).trim();\n  if (!/^[+-]?\\d+(?:\\.\\d{1,4})?$/.test(text)) throw new MoneyError('Expected a decimal amount with at most four fractional digits');\n  const cents = Math.round(Number(text) * 100);\n  if (!Number.isSafeInteger(cents)) throw new MoneyError('Amount exceeds safe integer range');\n  return Object.is(cents, -0) ? 0 : cents;\n}","newText": "export function parseMoney(value) {\n  const text = String(value).trim();\n  const match = /^([+-]?)(\\d+)(?:\\.(\\d{1,4}))?$/.exec(text);\n  if (!match) throw new MoneyError('Expected a decimal amount with at most four fractional digits');\n  const sign = match[1] === '-' ? -1n : 1n;\n  const integerPart = BigInt(match[2]);\n  const fracString = (match[3] || '').padEnd(4, '0');\n  const fracPart = BigInt(fracString);\n  // Total in ten-thousandths (4 decimal places)\n  const tenThousandths = integerPart * 10000n + fracPart;\n  // Round half away from zero to cents (factor of 100):\n  // (tenThousandths + 50) / 100\n  const centsBig = sign * ((tenThousandths + 50n) / 100n);\n  const cents = Number(centsBig);\n  if (!Number.isSafeInteger(cents)) throw new MoneyError('Amount exceeds safe integer range');\n  return Object.is(cents, -0) ? 0 : cents;\n}"}]},"id": "call_3848243"},"thoughtSignature": "EmkKZwFpFH0T9ezuFpJVFU2awOAiYXmAI4I6Sj2RckEKSuperZTUulthA6bIWqU1O6dwj113lHQF+jFQTT/rG8Gm9aLqtJg8niBGbJt2ZJ41EliTDkHBHrTTYXEFffIxGFVOH9rP3ZnHevQ="}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 25756,"candidatesTokenCount": 445,"totalTokenCount": 26201,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 25756}],"serviceTier": "standard","rawPromptTokenCount": 25827},"modelVersion": "gemini-3.8-flash","responseId": "2NbTas6hHtPBqtsPzv70kAY","turnToken": "v1_ChcyTmJUYXM2aEh0UEJxdHNQenY3MGtBWRIXMk5iVGFzNmhIdFBCcXRzUHp2NzBrQVk"}

