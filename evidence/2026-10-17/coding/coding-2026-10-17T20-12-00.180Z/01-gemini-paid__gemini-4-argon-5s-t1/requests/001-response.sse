data: {"candidates": [{"content": {"parts": [{"functionCall": {"name": "edit","args": {"path": "src/money.mjs","edits": [{"newText": "export function parseMoney(value) {\n  const text = String(value).trim();\n  const match = /^([+-]?)(\\d+)(?:\\.(\\d{1,4}))?$/.exec(text);\n  if (!match) throw new MoneyError('Expected a decimal amount with at most four fractional digits');\n  const sign = match[1] === '-' ? -1n : 1n;\n  const scaled = BigInt(match[2]) * 10000n + BigInt((match[3] ?? '').padEnd(4, '0'));\n  const cents = Number(sign * ((scaled + 50n) / 100n));\n  if (!Number.isSafeInteger(cents)) throw new MoneyError('Amount exceeds safe integer range');\n  return Object.is(cents, -0) ? 0 : cents;\n}","oldText": "export function parseMoney(value) {\n  const text = String(value).trim();\n  if (!/^[+-]?\\d+(?:\\.\\d{1,4})?$/.test(text)) throw new MoneyError('Expected a decimal amount with at most four fractional digits');\n  const cents = Math.round(Number(text) * 100);\n  if (!Number.isSafeInteger(cents)) throw new MoneyError('Amount exceeds safe integer range');\n  return Object.is(cents, -0) ? 0 : cents;\n}"}]},"id": "call_1468759"}}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 24995,"candidatesTokenCount": 449,"totalTokenCount": 25444,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 24995}],"rawPromptTokenCount": 25279},"modelVersion": "gemini-4-argon","responseId": "mdbTavrQKbzpz7IP256T-A8","turnToken": "v1_ChdtZGJUYXZyUUtienB6N0lQMjU2VC1BOBIXbWRiVGF2clFLYnpwejdJUDI1NlQtQTg"}

