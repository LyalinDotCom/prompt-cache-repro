data: {"candidates": [{"content": {"parts": [{"functionCall": {"name": "edit","args": {"path": "src/money.mjs","edits": [{"oldText": "export function parseMoney(value) {\n  const text = String(value).trim();\n  if (!/^[+-]?\\d+(?:\\.\\d{1,4})?$/.test(text)) throw new MoneyError('Expected a decimal amount with at most four fractional digits');\n  const cents = Math.round(Number(text) * 100);\n  if (!Number.isSafeInteger(cents)) throw new MoneyError('Amount exceeds safe integer range');\n  return Object.is(cents, -0) ? 0 : cents;\n}","newText": "export function parseMoney(value) {\n  const text = String(value).trim();\n  const match = /^([+-]?)(\\d+)(?:\\.(\\d{1,4}))?$/.exec(text);\n  if (!match) throw new MoneyError('Expected a decimal amount with at most four fractional digits');\n  const [, signText, whole, frac = ''] = match;\n  const subUnits = BigInt(whole) * 10000n + BigInt(frac.padEnd(4, '0'));\n  const rounded = (subUnits + 50n) / 100n;\n  const cents = (signText === '-' ? -1 : 1) * Number(rounded);\n  if (!Number.isSafeInteger(cents)) throw new MoneyError('Amount exceeds safe integer range');\n  return Object.is(cents, -0) ? 0 : cents;\n}"}]},"id": "call_3410620"}}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 24998,"candidatesTokenCount": 538,"totalTokenCount": 25536,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 24998}],"rawPromptTokenCount": 25280},"modelVersion": "gemini-4-argon","responseId": "ftnTatatB6n9qtsPs82C0AE","turnToken": "v1_ChdmdG5UYXRhdEI2bjlxdHNQczgyQzBBRRIXZnRuVGF0YXRCNm45cXRzUHM4MkMwQUU"}

