data: {"candidates": [{"content": {"parts": [{"functionCall": {"name": "edit","args": {"edits": [{"newText": "export function parseMoney(value) {\n  const text = String(value).trim();\n  const match = /^([+-]?)(\\d+)(?:\\.(\\d{1,4}))?$/.exec(text);\n  if (!match) throw new MoneyError('Expected a decimal amount with at most four fractional digits');\n  const [, signStr, intStr, fracStr = ''] = match;\n  const sign = signStr === '-' ? -1n : 1n;\n  const paddedFrac = fracStr.padEnd(4, '0');\n  const units10000 = sign * (BigInt(intStr) * 10000n + BigInt(paddedFrac));\n  const absUnits = units10000 \u003c 0n ? -units10000 : units10000;\n  const roundedAbsCents = (absUnits + 50n) / 100n;\n  const centsBigInt = sign * roundedAbsCents;\n  const cents = Number(centsBigInt);\n  if (!Number.isSafeInteger(cents)) throw new MoneyError('Amount exceeds safe integer range');\n  return Object.is(cents, -0) ? 0 : cents;\n}","oldText": "export function parseMoney(value) {\n  const text = String(value).trim();\n  if (!/^[+-]?\\d+(?:\\.\\d{1,4})?$/.test(text)) throw new MoneyError('Expected a decimal amount with at most four fractional digits');\n  const cents = Math.round(Number(text) * 100);\n  if (!Number.isSafeInteger(cents)) throw new MoneyError('Amount exceeds safe integer range');\n  return Object.is(cents, -0) ? 0 : cents;\n}"}],"path": "src/money.mjs"},"id": "call_4728362"},"thoughtSignature": "EmkKZwFpFH0T1SO2o9vyoS+CD9yLqil9uToDL+hZm9M+LEWuGamuCf4s1tR81+4zlSTiEEo/NVfL4kQhU8YTkXk2wos7uogZCXXOymAKV2olx1MI9AKxdIMVFotZLY8BwJL5SiZnLX5/QvE="}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 29218,"candidatesTokenCount": 441,"totalTokenCount": 29659,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 29218}],"serviceTier": "standard","rawPromptTokenCount": 29339},"modelVersion": "gemini-3.8-flash","responseId": "_9fTarXEA67pz7IPvJOGsAo","turnToken": "v1_ChdfOWZUYXJYRUE2N3B6N0lQdkpPR3NBbxIXXzlmVGFyWEVBNjdwejdJUHZKT0dzQW8"}

