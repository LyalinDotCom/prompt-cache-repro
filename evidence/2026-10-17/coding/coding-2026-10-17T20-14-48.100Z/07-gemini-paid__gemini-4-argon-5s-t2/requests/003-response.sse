data: {"candidates": [{"content": {"parts": [{"functionCall": {"name": "edit","args": {"path": "src/money.mjs","edits": [{"oldText": "export function parseMoney(value) {\n  const text = String(value).trim();\n  if (!/^[+-]?\\d+(?:\\.\\d{1,4})?$/.test(text)) throw new MoneyError('Expected a decimal amount with at most four fractional digits');\n  const cents = Math.round(Number(text) * 100);\n  if (!Number.isSafeInteger(cents)) throw new MoneyError('Amount exceeds safe integer range');\n  return Object.is(cents, -0) ? 0 : cents;\n}","newText": "export function parseMoney(value) {\n  const text = String(value).trim();\n  const match = /^([+-])?(\\d+)(?:\\.(\\d{1,4}))?$/.exec(text);\n  if (!match) throw new MoneyError('Expected a decimal amount with at most four fractional digits');\n  const [, signSymbol, whole, frac = ''] = match;\n  const subUnits = BigInt(whole) * 10000n + BigInt(frac.padEnd(4, '0'));\n  const rounded = (subUnits + 50n) / 100n;\n  const cents = Number(signSymbol === '-' ? -rounded : rounded);\n  if (!Number.isSafeInteger(cents)) throw new MoneyError('Amount exceeds safe integer range');\n  return Object.is(cents, -0) ? 0 : cents;\n}"}]},"id": "call_2898434"}}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 39292,"candidatesTokenCount": 454,"totalTokenCount": 39746,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 39292}],"rawPromptTokenCount": 39864},"modelVersion": "gemini-4-argon","responseId": "AdnTapOqCszVz7IP26z1mQ4","turnToken": "v1_ChdBZG5UYXBPcUNzelZ6N0lQMjZ6MW1RNBIXQWRuVGFwT3FDc3pWejdJUDI2ejFtUTQ"}

