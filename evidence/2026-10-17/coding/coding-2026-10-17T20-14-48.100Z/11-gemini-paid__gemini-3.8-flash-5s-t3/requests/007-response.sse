data: {"candidates": [{"content": {"parts": [{"functionCall": {"name": "edit","args": {"path": "src/money.mjs","edits": [{"newText": "export function parseMoney(value) {\n  const text = String(value).trim();\n  if (!/^[+-]?\\d+(?:\\.\\d{1,4})?$/.test(text)) throw new MoneyError('Expected a decimal amount with at most four fractional digits');\n  const sign = text.startsWith('-') ? -1n : 1n;\n  const unsigned = text.replace(/^[+-]/, '');\n  const [wholeStr, fracStr = ''] = unsigned.split('.');\n  const fracPadded = fracStr.padEnd(4, '0');\n  const whole = BigInt(wholeStr);\n  const frac4 = BigInt(fracPadded);\n  const totalUnits = whole * 10000n + frac4;\n  const centsBig = (totalUnits + 50n) / 100n;\n  const cents = Number(centsBig) * Number(sign);\n  if (!Number.isSafeInteger(cents)) throw new MoneyError('Amount exceeds safe integer range');\n  return Object.is(cents, -0) ? 0 : cents;\n}","oldText": "export function parseMoney(value) {\n  const text = String(value).trim();\n  if (!/^[+-]?\\d+(?:\\.\\d{1,4})?$/.test(text)) throw new MoneyError('Expected a decimal amount with at most four fractional digits');\n  const cents = Math.round(Number(text) * 100);\n  if (!Number.isSafeInteger(cents)) throw new MoneyError('Amount exceeds safe integer range');\n  return Object.is(cents, -0) ? 0 : cents;\n}"}]},"id": "call_233954"},"thoughtSignature": "EmkKZwFpFH0Tvi3MN8eTSBr6L28+fvf78sCVytn7Y4kDlIlZoQSlNmVKh+qTFSrXjRL4izcFqSkmCuPQbuT3smDQ1xKnsVlJxvNXQ3gbORJqwYh6G3JAcJg6Wv9lr8b2kgI3OWKSHpkItVA="}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 29684,"candidatesTokenCount": 410,"totalTokenCount": 30094,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 29684}],"serviceTier": "standard","rawPromptTokenCount": 29805},"modelVersion": "gemini-3.8-flash","responseId": "0NnTau7mAbnoz7IPlZWXoQ0","turnToken": "v1_ChcwTm5UYXU3bUFibm96N0lQbFpXWG9RMBIXME5uVGF1N21BYm5vejdJUGxaV1hvUTA"}

