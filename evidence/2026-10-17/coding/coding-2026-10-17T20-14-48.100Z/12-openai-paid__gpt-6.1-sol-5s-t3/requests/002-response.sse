event: response.output_text.done
data: {"type":"response.output_text.done","content_index":0,"item_id":"msg_0dca1f67bb1588df016ad3da0e7aa087d2b4f0ca8d37361560","logprobs":[],"output_index":1,"sequence_number":173,"text":"The baseline has 6 failures out of 44 tests. The causes are in `src/csv.mjs`, `src/money.mjs`, and `src/dedupe.mjs`: the scanner never commits an EOF record, money parsing uses floating-point rounding, and invoice keys omit the vendor. Payment routing already uses the shared invoice-key function, so fixing that key will also fix routing."}

event: response.content_part.done
