data: {"type":"response.function_call_arguments.delta","delta":"{\"path\":\"src/money.mjs\",\"edits\":[{\"oldText\":\"  const cents = Math.round(Number(text) * 100);\\n  if (!Number.isSafeInteger(cents)) throw new MoneyError('Amount exceeds safe integer range');\\n  return Object.is(cents, -0) ? 0 : cents;\",\"newText\":\"  const [whole, fraction = ''] = text.replace(/^[+-]/, '').split('.');\\n  // Work in ten-thousandths so decimal ties are exact, including credits.\\n  const magnitude = BigInt(whole) * 10000n + BigInt(fraction.padEnd(4, '0'));\\n  const rounded = (magnitude + 50n) / 100n;\\n  if (rounded > BigInt(Number.MAX_SAFE_INTEGER)) throw new MoneyError('Amount exceeds safe integer range');\\n  return Number(text.startsWith('-') ? -rounded : rounded);\"}]}","item_id":"fc_0dca1f67bb1588df016ad3da1435b487d2aad59077d90ff966","obfuscation":"NNNlZHXMjzTQ4h5","output_index":4,"sequence_number":185}

