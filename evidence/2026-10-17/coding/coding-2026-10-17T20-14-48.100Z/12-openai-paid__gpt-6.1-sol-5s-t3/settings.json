{
  "piVersion": "1.3.0",
  "cacheWarming": "off",
  "compaction": {
    "enabled": false
  },
  "retry": {
    "enabled": false,
    "provider": {
      "maxRetries": 0,
      "timeoutMs": 90000
    }
  },
  "maxRequests": 12,
  "maxTokens": 4096,
  "gapSeconds": 5,
  "timeoutMs": 480000,
  "tools": [
    "read",
    "edit",
    "write",
    "bash"
  ],
  "bashCommand": "node --test",
  "mutablePaths": [
    "src/",
    "bin/"
  ],
  "runtime": "node",
  "auth": "explicit paid API key; operator-declared tier",
  "allowedBashCommands": [
    "node --test",
    "node --test test/*.test.mjs",
    "npm test",
    "node bin/ledger.mjs import data/invoices.csv --payments data/payments.csv --as-of 2026-03-01 --format json"
  ]
}
