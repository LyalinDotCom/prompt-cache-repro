data: {"candidates": [{"content": {"parts": [{"functionCall": {"name": "edit","args": {"path": "src/money.mjs","edits": [{"oldText": "export function parseMoney(value) {\n  const text = String(value).trim();\n  if (!/^[+-]?\\d+(?:\\.\\d{1,4})?$/.test(text)) throw new MoneyError('Expected a decimal amount with at most four fractional digits');\n  const cents = Math.round(Number(text) * 100);\n  if (!Number.isSafeInteger(cents)) throw new MoneyError('Amount exceeds safe integer range');\n  return Object.is(cents, -0) ? 0 : cents;\n}","newText": "export function parseMoney(value) {\n  const text = String(value).trim();\n  if (!/^[+-]?\\d+(?:\\.\\d{1,4})?$/.test(text)) throw new MoneyError('Expected a decimal amount with at most four fractional digits');\n  const sign = text.startsWith('-') ? -1n : 1n;\n  const unsigned = text.replace(/^[+-]/, '');\n  const [wholeStr, fracStr = ''] = unsigned.split('.');\n  const fracPadded = fracStr.padEnd(4, '0');\n  const frac4 = BigInt(fracPadded);\n  const whole = BigInt(wholeStr);\n  const frac2 = (frac4 + 50n) / 100n;\n  const totalCentsBigInt = sign * (whole * 100n + frac2);\n  const cents = Number(totalCentsBigInt);\n  if (!Number.isSafeInteger(cents)) throw new MoneyError('Amount exceeds safe integer range');\n  return Object.is(cents, -0) ? 0 : cents;\n}"}]},"id": "call_2306528"},"thoughtSignature": "EmkKZwFpFH0TETk2uxkVooM37DuY/YQVUytamKUVKql7gNFT8M5yB5Oya503qCKBRBzJ2PGAmgw5GGl1y69nl4BiKcpfz/IZPthW9OXYC4mH/l9yPPD7G9dSX5v048YU7rXUDycYvN0NXi8="}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 30911,"candidatesTokenCount": 412,"totalTokenCount": 31323,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 30911}],"serviceTier": "standard","rawPromptTokenCount": 31042},"modelVersion": "gemini-3.8-flash","responseId": "wtjTap7HNOnqz7IP3eOXwQw","turnToken": "v1_Chd3dGpUYXA3SE5PbnF6N0lQM2VPWHdRdxIXd3RqVGFwN0hOT25xejdJUDNlT1h3UXc"}

